# Copy this file to .env.production on the server and fill in real values.
# .env.production is gitignored and read by docker-compose via env_file.

# Server
HOST=0.0.0.0
PORT=1337

# Secrets (generate fresh values for production — do not reuse dev secrets)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
